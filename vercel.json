{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": { "runtime": "@vercel/node@20.x" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/verify.html", "destination": "/verify.html" },
    { "source": "/verify/:certId", "destination": "/verify.html" },
    { "source": "/verify/:certId/", "destination": "/verify.html" }
  ]
}
